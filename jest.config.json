{
  "projects": [
    {
      "displayName": "unit",
      "rootDir": ".",
      "testEnvironment": "node",
      "setupFiles": ["<rootDir>/test/unit/setup.ts"],
      "testMatch": ["<rootDir>/test/unit/**/*.unit.spec.ts"],
      "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
      },
      "moduleFileExtensions": ["js", "json", "ts"]
    },
    {
      "displayName": "e2e",
      "rootDir": ".",
      "testEnvironment": "node",
      "testMatch": ["<rootDir>/test/e2e/**/*.e2e-spec.ts"],
      "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
      },
      "moduleFileExtensions": ["js", "json", "ts"]
    }
  ]
}
